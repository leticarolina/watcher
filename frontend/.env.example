# RPC URL used for the Sepolia transport in src/lib/wagmiConfig.ts.
# If unset, a public Sepolia RPC is used as a fallback (rate-limited — fine
# for local dev, get your own from Alchemy/Infura/etc. for anything real).
VITE_SEPOLIA_RPC_URL=https://your-sepolia-rpc-url

# WalletConnect Cloud project ID, required by RainbowKit to enable the
# WalletConnect connector. Get a free one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# HTTP address of a running Speculos instance (see LEDGER_DEMO_SETUP.md at
# the repo root for how to launch one). If unset, defaults to the same
# address @ledgerhq/device-transport-kit-speculos itself defaults to.
VITE_SPECULOS_URL=http://127.0.0.1:5001
